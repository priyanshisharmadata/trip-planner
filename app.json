{
  "expo": {
    "name": "Roam",
    "slug": "trip-planner",
    "version": "1.2.2",
    "scheme": "roamplanner",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "orientation": "portrait",
    "icon": "./assets/roam-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.roamplanner.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#245C44",
        "foregroundImage": "./assets/roam-adaptive-foreground.png",
        "monochromeImage": "./assets/roam-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    }
  }
}
